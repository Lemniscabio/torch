# Copy to .env.local for dev.

# Direct URL of the Express backend. Browser talks to this directly — no BFF.
# Dev:   http://localhost:4000
# Prod:  https://api.torch.lemnisca.bio   (Cloud Run custom domain)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Public site URL (used for canonical links, OG metadata, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_POSTHOG_KEY=---key---
NEXT_PUBLIC_POSTHOG_HOST=https://${server}.i.posthog.com