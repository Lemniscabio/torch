# Copy to .env for local dev. Each var has dev defaults baked into src/config/env.ts.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (local: docker compose service; prod: Cloud SQL) ---
# Local:
DATABASE_URL=postgresql://torch:torch@localhost:5432/torch?schema=public
# Cloud Run via Cloud SQL Auth Proxy (Unix socket):
# DATABASE_URL=postgresql://USER:PASSWORD@localhost/DB?host=/cloudsql/PROJECT:REGION:INSTANCE&schema=public

# --- Auth ---
# Generate via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-real-48-byte-secret

# --- Frontend origin (CORS allowlist) ---
# Dev:
FRONTEND_URL=http://localhost:3000
# Prod: FRONTEND_URL=https://torch.lemnisca.bio

# --- Cookies ---
# Leave COOKIE_DOMAIN unset locally; set to .lemnisca.bio in prod so the cookie
# is shared between torch.lemnisca.bio (Vercel) and api.torch.lemnisca.bio (Cloud Run).
# COOKIE_DOMAIN=.lemnisca.bio
# COOKIE_SECURE=true
